# =============================================================================
# .env.docker.example — Variáveis de ambiente para o ambiente Docker dev/test.
#
# Copie para `.env.docker` (gitignored) e ajuste conforme necessário:
#
#   cp .env.docker.example .env.docker
#
# Uso:
#   docker compose --env-file .env.docker up --build
#
# TODOS os valores aqui são EXEMPLOS INSEGUROS para desenvolvimento local.
# NUNCA use estes valores em produção. Para produção, veja:
#   - deploy/helm/values-prod.yaml (em F10)
#   - .env.example para dev local sem Docker
# =============================================================================

# === PostgreSQL (serviço `postgres` do compose) ===
# POSTGRES_USER/DB devem casar com DATABASE_URL abaixo (mas o compose interpola
# ambos do mesmo lugar, então basta editar aqui).
POSTGRES_USER=aipp
POSTGRES_PASSWORD=aipp_dev_insecure_change_me
POSTGRES_DB=aipp
# (POSTGRES_PORT foi removido: o PostgreSQL NÃO é mais exposto no host — só
# acessível na rede interna do compose pelo service `app`. Nenhuma porta de DB
# aberta externamente.)

# === App ===
# Porta do host (única porta exposta — só o proxy HTTP):
APP_PORT=8088

# === Logging ===
LOG_LEVEL=info
# text é mais legível em terminal; json é melhor para stack de logs (Loki/CloudWatch).
LOG_FORMAT=text

# === Segredos DEV (INSEGUROS — substitua para qualquer uso além do primeiro teste) ===

# Pepper para HMAC-SHA256 dos tokens sk-aipp-... (mínimo 32 bytes).
# Use um valor aleatório de 64+ bytes em qualquer deploy que não seja "hello world".
# Para gerar: openssl rand -base64 48
AIPP_TOKEN_PEPPER=DEV_MODE_INSECURE_PEPPER_32_BYTES_LONG_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# KEK (Key Encryption Key) para AES-256-GCM envelope encryption das chaves de
# provedores no PostgreSQL.
#   - Vazio: app usa IdentityDecryptor (plaintext no DB). Aceitável SÓ em dev.
#   - Para ativar AES-GCM:
#       1. ./scripts/gen-kek.sh           # gera kek-dev.key (32 bytes random)
#       2. KEK_PATH=/run/secrets/kek
#       3. Descomente o volume `./kek-dev.key:/run/secrets/kek:ro` no compose.
KEK_PATH=

# === Bootstrap admin (criado automaticamente no startup em DEV_MODE) ===
# Idempotente: se o usuário já existe, não altera.
# Mínimo 12 caracteres na senha (validação no app).
AIPP_BOOTSTRAP_ADMIN_USERNAME=admin
AIPP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!StrongDevPassword123

# =============================================================================
# As variáveis abaixo NÃO precisam ser ajustadas para o uso básico.
# Defaults do docker-compose.yml cobrem estes casos.
# =============================================================================

# === Timeouts do proxy upstream (defaults em config.go) ===
# UPSTREAM_DIAL_TIMEOUT=5s
# UPSTREAM_TLS_HANDSHAKE_TIMEOUT=5s
# UPSTREAM_RESPONSE_HEADER_TIMEOUT=30s
# UPSTREAM_OVERALL_TIMEOUT=10m
# UPSTREAM_FIRST_BYTE_TIMEOUT=30s
# UPSTREAM_IDLE_CHUNK_TIMEOUT=60s
# UPSTREAM_MAX_IDLE_CONNS_PER_HOST=100
# REQUEST_BODY_MAX_BYTES=10485760

# === Graceful shutdown ===
# SHUTDOWN_TIMEOUT=60s
# PRESTOP_SLEEP=10s

# === Afinidade de cache de contexto + rate limit ===
# AFFINITY_TTL=30m
# AFFINITY_MAX_PER_USER=50
# RATE_LIMIT_BURST=10
# RATE_LIMIT_PER_MIN=60

# === Multi-tenant (organização default) ===
# DEFAULT_ORG_ID=1

# === URL pública do serviço (links de convite / configuração de clientes) ===
# Se não definida, faz fallback para o Host do request.
# AIPP_PUBLIC_URL=http://localhost:8088

# === Feature flags (preparação ROADMAP) ===
# ENABLE_METRICS=false   # endpoint /metrics (off no MVP, spec §3.5.4)
