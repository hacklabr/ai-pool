# Exemplo de variáveis de ambiente para desenvolvimento local.
# Copie para `.env` (gitignored) e ajuste conforme necessário.

# HTTP
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=10s

# Proxy upstream (timeouts)
UPSTREAM_DIAL_TIMEOUT=5s
UPSTREAM_TLS_HANDSHAKE_TIMEOUT=5s
UPSTREAM_RESPONSE_HEADER_TIMEOUT=30s
UPSTREAM_OVERALL_TIMEOUT=10m
UPSTREAM_FIRST_BYTE_TIMEOUT=30s
UPSTREAM_IDLE_CHUNK_TIMEOUT=60s
UPSTREAM_MAX_IDLE_CONNS_PER_HOST=100
REQUEST_BODY_MAX_BYTES=10485760

# Graceful shutdown
SHUTDOWN_TIMEOUT=60s
PRESTOP_SLEEP=10s

# Database (em F2: docker-compose sobe Postgres local)
DATABASE_URL=postgres://aipp:aipp@localhost:5432/aipp?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Segredos (paths para arquivos montados via Secret/ESO em prod).
# Em dev: gerar arquivos locais (ver docs/security-dev.md em F7).
KEK_PATH=/run/secrets/kek
TOKEN_PEPPER_PATH=/run/secrets/token_pepper

# Observabilidade
LOG_LEVEL=info
LOG_FORMAT=text

# Afonia/Rate-limit defaults
AFFINITY_TTL=30m
AFFINITY_MAX_PER_USER=50
RATE_LIMIT_BURST=10
RATE_LIMIT_PER_MIN=60

# Multi-tenant
DEFAULT_ORG_ID=1

# Feature flags
ENABLE_METRICS=false
DEV_MODE=true
